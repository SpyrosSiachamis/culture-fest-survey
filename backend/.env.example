# Backend configuration — copy to backend/.env and fill in real values.
# Placeholders only. Never commit a file containing real secrets.

# --- Authentication -------------------------------------------------------------------------
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
# Server-side secret mixed into the one-way hashes of emails and phone numbers, and used as the
# HMAC key for verification codes. Changing it invalidates every existing account login and every
# verification code in flight. Generate with: openssl rand -hex 32
PEPPER=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- CORS -----------------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Must include every origin the frontend
# is actually browsed from — an origin is scheme + host + port, so http://localhost:3000 does NOT
# cover http://<tailscale-host>:3000.
#
# The entries below cover: the laptop itself, the tailnet MagicDNS name, the raw tailnet IP, and
# `tailscale serve` (which terminates TLS on 443, so no port on that one). Drop whichever you
# don't use, and change the ports if FRONTEND_PORT is not 3000.
ALLOWED_ORIGINS=http://localhost:3000,http://spiross-laptop.taila0d570.ts.net:3000,http://100.103.8.27:3000,https://spiross-laptop.taila0d570.ts.net

# --- Database -------------------------------------------------------------------------------
DB_USER=culture_fest
DB_PASSWORD=replace-with-the-mysql-password
DB_HOST=culture-fest-mysql
DB_PORT=3306
DB_NAME=culture_fest

# --- Email (Resend) -------------------------------------------------------------------------
# API key from https://resend.com/api-keys. Read from the environment only — never hardcode it.
# If this is unset the app still runs, but verification emails are skipped and a warning is logged.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Must be an address on a domain verified in your Resend account.
EMAIL_FROM=Culture Fest <noreply@example.com>
# Shown in the email subject and body.
APP_NAME=Culture Fest

# --- Email verification policy --------------------------------------------------------------
# All optional; the defaults below are what the application uses when they are not set.
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_RESENDS=5
