# Backend configuration — copy to backend/.env and fill in real values.
# Placeholders only. Never commit a file containing real secrets.

# --- Authentication -------------------------------------------------------------------------
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
# Server-side secret mixed into the one-way hashes of emails and phone numbers, and used as the
# HMAC key for verification codes. Changing it invalidates every existing account login and every
# verification code in flight. Generate with: openssl rand -hex 32
PEPPER=replace-with-a-long-random-string
# How long a sign-in lasts. Also the lifetime of the session cookie, so this is what decides how
# long "still signed in after a refresh" holds for. 720 = 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Session cookie -------------------------------------------------------------------------
# Login sets an HttpOnly cookie; the browser sends it back on every call, which is what keeps the
# user signed in across reloads. These control how it is scoped.
#
# MUST be true anywhere the site is served over HTTPS. It is false by default only because the dev
# stack runs on plain HTTP over the tailnet, where a Secure cookie would never be stored at all.
AUTH_COOKIE_SECURE=false
# lax is right while the frontend and the API share a host (they differ only by port, and a port
# is not part of a "site"). It also means the browser withholds the cookie from cross-site POSTs,
# which is the CSRF defence. Use "none" — which requires AUTH_COOKIE_SECURE=true — only if the API
# moves to a genuinely different site from the frontend.
AUTH_COOKIE_SAMESITE=lax
# Leave unset for a host-only cookie. Set to a parent domain (e.g. .example.com) only if the app
# and API live on different subdomains of it.
# AUTH_COOKIE_DOMAIN=

# --- Event window ---------------------------------------------------------------------------
# When the QR redemption codes stop being valid — they are minted with this as their expiry, so a
# code cannot be kept and presented at next year's festival. ISO 8601; naive values are read as
# UTC. Unset means 30 days from issue.
# EVENT_END=2026-09-01T04:00:00+03:00
# The other half of the guard, for the door-redemption endpoint that is not built yet: no code may
# be redeemed before this, since voting opens well ahead of the event.
# EVENT_START=2026-08-31T18:00:00+03:00

# --- CORS -----------------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Must include every origin the frontend
# is actually browsed from — an origin is scheme + host + port, so http://localhost:3000 does NOT
# cover http://<tailscale-host>:3000.
#
# The entries below cover: the laptop itself, the tailnet MagicDNS name, the raw tailnet IP, and
# `tailscale serve` (which terminates TLS on 443, so no port on that one). Drop whichever you
# don't use, and change the ports if FRONTEND_PORT is not 3000.
ALLOWED_ORIGINS=http://localhost:3000,http://spiross-laptop.taila0d570.ts.net:3000,http://100.103.8.27:3000,https://spiross-laptop.taila0d570.ts.net

# --- Reverse proxy --------------------------------------------------------------------------
# Only needed when a reverse proxy (Caddy, `tailscale serve`, nginx…) sits in front of the API.
# The rate limiter keys on the client IP; behind a proxy every request comes from the proxy, so
# without this all callers share one rate-limit bucket. Set this to the proxy's address(es),
# comma-separated, and X-Forwarded-For will be honoured ONLY from those peers — a client cannot
# spoof the header to forge or dodge a limit.
#
# Leave unset for direct exposure (the dev stack): X-Forwarded-For is then ignored entirely.
# Do NOT use "*" on a publicly reachable backend — it trusts the header from anyone.
# TRUSTED_PROXY_IPS=127.0.0.1

# --- Database -------------------------------------------------------------------------------
DB_USER=culture_fest
DB_PASSWORD=replace-with-the-mysql-password
DB_HOST=culture-fest-mysql
DB_PORT=3306
DB_NAME=culture_fest

# --- Email (Resend) -------------------------------------------------------------------------
# API key from https://resend.com/api-keys. Read from the environment only — never hardcode it.
# If this is unset the app still runs, but verification emails are skipped and a warning is logged.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Must be an address on a domain verified in your Resend account.
EMAIL_FROM=Culture Fest 2026 <noreply@example.com>
# Shown in the email subject and body.
APP_NAME=Culture Fest

# --- Email verification policy --------------------------------------------------------------
# All optional; the defaults below are what the application uses when they are not set.
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_RESENDS=5

# --- Limits ---------------------------------------------------------------------------------
# Largest request body the API will read, in bytes. Every endpoint takes a small JSON object, so
# the 64 KiB default is generous; a body over it is refused with 413 before being parsed. Optional.
# MAX_REQUEST_BODY_BYTES=65536

# --- API Documentation ----------------------------------------------------------------------
# Set ENVIRONMENT=production (or ENABLE_DOCS=false) to disable /docs, /redoc, and /openapi.json.
# In development, interactive docs are enabled by default.
# ENVIRONMENT=development
# ENABLE_DOCS=true
