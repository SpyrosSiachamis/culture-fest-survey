# Root configuration — copy to .env. Used by docker-compose for port mapping and MySQL setup.
# Placeholders only. Never commit a file containing real secrets.

# Host ports the stack is published on.
BACKEND_PORT=5000
FRONTEND_PORT=3000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# MySQL bootstrap credentials. DB_USER/DB_PASSWORD/DB_NAME in backend/.env must match
# MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE below.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=culture_fest
MYSQL_USER=culture_fest
MYSQL_PASSWORD=replace-with-a-strong-password
