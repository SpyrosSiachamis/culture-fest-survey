# Frontend configuration — copy to frontend/.env.
# NEXT_PUBLIC_ variables are inlined into the browser bundle, so never put a secret here.

# Base URL of the FastAPI backend as reached from the *browser*, not from inside Docker.
# Must match the host port docker-compose publishes for the backend (BACKEND_PORT in the root .env),
# and the origin must be listed in ALLOWED_ORIGINS in backend/.env or requests will fail CORS.
NEXT_PUBLIC_API_URL=http://localhost:5000
