# Frontend configuration — copy to frontend/.env.
# NEXT_PUBLIC_ variables are inlined into the browser bundle, so never put a secret here.

# Base URL of the FastAPI backend as reached from the *browser*, not from inside Docker.
# Match the host port that docker-compose publishes for the backend (BACKEND_PORT in the root .env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
