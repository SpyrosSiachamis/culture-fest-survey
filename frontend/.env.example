# Frontend configuration — copy to frontend/.env.
# NEXT_PUBLIC_ variables are inlined into the browser bundle, so never put a secret here.

# Base URL of the FastAPI backend as reached from the *browser* — not from inside Docker, and not
# from the machine running the stack.
#
# This is the one that bites when accessing over Tailscale: "localhost" is resolved by whichever
# device has the page open, so a phone would try to reach itself and every API call would fail.
# Use a host the browsing device can actually reach.
#
# Local only:
# NEXT_PUBLIC_API_URL=http://localhost:5000
#
# Reachable over the tailnet (MagicDNS name of the machine running Docker):
NEXT_PUBLIC_API_URL=http://spiross-laptop.taila0d570.ts.net:5000

# Whatever you set here, the matching frontend origin must appear in ALLOWED_ORIGINS in
# backend/.env, and the port must match BACKEND_PORT in the root .env.
